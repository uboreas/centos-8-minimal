#!/bin/bash

export BUILD_RUN_TYPE="ISO"

# Disable firstboot script on next boot
chmod -x /etc/init.d/firstboot

function outs {
   echo "$(date +%H:%M:%S): $*"
}


function on_error {
    echo "ERROR on line $1"
}

function on_exit {
    echo "EXIT"
}


#set -x -v

LOGFILE="/root/firstboot.log"
touch $LOGFILE
chmod 640 $LOGFILE

exec 3>&1 4>&2 1>>$LOGFILE 2>&1

trap 'on_error $LINENO' ERR
trap on_exit            EXIT

outs "firstboot started"

outs "Wait for boot to complete..."
sleep 10

outs "installing python modules"

# update pip to required version
outs "Upgrade pip to latest version"
pip3 install --no-index --find-links="/repo/PyRepo" pip==21.3.1 

# install rest of the python modules
outs "Installing python modules"
pip3 install --no-index --find-links="/repo/PyRepo" -r /root/python.modules

echo "Installing rest of the packages"
dnf clean all 
dnf module enable idm:DL1 -y
dnf distro-sync -y
dnf reposync 
dnf update -y

dnf groupinstall -y virtualization-client 
dnf install -y openvpn ruby-devel nodejs
dnf install -y freeipa-server freeipa-server-dns

outs "ready for final reboot..."
reboot
